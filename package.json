{
	"name": "container-manager",
	"description": "Open matching URLs in Firefox containers and assign a separate proxy to each container.",
	"license": "GPL-3.0-or-later",
	"private": true,
	"scripts": {
		"start": "concurrently \"webpack --watch\" \"web-ext run --source-dir build/webpack\"",
		"watch:webpack": "webpack --watch",
		"lint": "web-ext lint",
		"build": "webpack && web-ext build",
		"build:webpack": "webpack",
		"sign": "dotenv -- web-ext sign --channel=listed",
		"sign:dev": "dotenv -- web-ext sign --channel=unlisted",
		"clean": "npm run clean:webpack && npm run clean:extension",
		"clean:webpack": "rm -rf build",
		"clean:extension": "rm -rf web-ext-artifacts",
		"test": "node --test"
	},
	"dependencies": {
		"concurrently": "^10.0.5",
		"copy-webpack-plugin": "^14.0.0",
		"css-loader": "^7.1.5",
		"html-webpack-plugin": "^5.6.8",
		"sass": "^1.105.1",
		"sass-loader": "^17.0.1",
		"style-loader": "^4.0.0",
		"uuid": "^14.0.2",
		"vue": "^3.5.43",
		"vue-loader": "^17.4.2",
		"web-ext": "10.7.0",
		"webpack": "^5.111.1",
		"webpack-cli": "^7.2.3"
	},
	"devDependencies": {
		"dotenv-cli": "^11.0.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "yarn@1.22.22"
}
